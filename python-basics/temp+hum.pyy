import dht
from machine import Pin, I2C
from ssd1306 import SSD1306_I2C
import dht
import time

# OLED setup
i2c = I2C(0, sda=Pin(0), scl=Pin(1))
oled = SSD1306_I2C(128, 64, i2c)

# DHT22 setup
sensor = dht.DHT22(Pin(2))

# RGB LED setup
red = Pin(16, Pin.OUT)
blue = Pin(17, Pin.OUT)
green = Pin(18, Pin.OUT)

while True:
    
    sensor.measure()
    temp = sensor.temperature()
    hum = sensor.humidity()

    # OLED display
    oled.fill(0)
    oled.text("Temp: {}C".format(temp),0,10)
    oled.text("Hum: {}%".format(hum),0,25)
    oled.show()

    # LED color depending on temperature
    if temp < 24:
        blue.on()
        red.off()
        green.off()

    elif temp < 30:
        green.on()
        red.off()
        blue.off()

    else:
        red.on()
        green.off()
        blue.off()

    time.sleep(2)